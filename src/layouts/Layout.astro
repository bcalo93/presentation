---
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/assets/styles/palette.scss';
import '@/assets/styles/reset.scss';
import '@/assets/styles/commons.scss';
import { getHomePath } from '@/i18n/config';
import type { Locale } from '@/i18n/config';

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string;
  alternatePaths: Record<Locale, string>;
  page: 'home' | 'project' | 'writing';
  slug?: string;
  switcherPath?: string;
  homeEntry: import('astro:content').CollectionEntry<'home'>;
}

const {
  title,
  description,
  locale,
  canonicalPath,
  alternatePaths,
  page,
  slug,
  switcherPath,
  homeEntry,
} = Astro.props;
const goatCounterDomain = import.meta.env.PUBLIC_GOATCOUNTER_DOMAIN;
---

<!doctype html>
<html lang={locale}>
  <head>
    <Seo
      title={title}
      description={description}
      locale={locale}
      canonicalPath={canonicalPath}
      alternates={[
        { locale: 'en', href: alternatePaths.en ?? getHomePath('en') },
        { locale: 'es', href: alternatePaths.es ?? getHomePath('es') },
      ]}
    />
    <script is:inline>
      (() => {
        const storageKey = 'theme';
        const storedTheme = localStorage.getItem(storageKey);
        const theme = storedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    {goatCounterDomain && (
      <script
        async
        data-goatcounter={`https://${goatCounterDomain}/count`}
        src="https://gc.zgo.at/count.js"
      ></script>
    )}
  </head>
  <body>
    <Header locale={locale} page={page} slug={slug} switcherPath={switcherPath} homeEntry={homeEntry} />
    <main class="page-shell">
      <slot />
    </main>
    <Footer locale={locale} page={page} slug={slug} homeEntry={homeEntry} />
  </body>
</html>
