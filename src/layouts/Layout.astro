---
import Seo from "@/components/Seo.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import "@/assets/styles/fonts.scss";
import "@/assets/styles/palette.scss";
import "@/assets/styles/reset.scss";
import "@/assets/styles/commons.scss";
import { getHomePath } from "@/i18n/config";
import type { Locale } from "@/i18n/config";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  canonicalPath: string;
  alternatePaths: Record<Locale, string>;
  page: "home" | "project";
  slug?: string;
  homeEntry: import("astro:content").CollectionEntry<"home">;
}

const {
  title,
  description,
  locale,
  canonicalPath,
  alternatePaths,
  page,
  slug,
  homeEntry,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <Seo
      title={title}
      description={description}
      locale={locale}
      canonicalPath={canonicalPath}
      alternates={[
        { locale: "en", href: alternatePaths.en ?? getHomePath("en") },
        { locale: "es", href: alternatePaths.es ?? getHomePath("es") },
      ]}
    />
    <meta name="theme-color" id="theme-color" content="#F4F1EA" />
    <script is:inline>
      (() => {
        const storageKey = "theme";
        const storedTheme = localStorage.getItem(storageKey);
        const theme =
          storedTheme ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light");
        document.documentElement.dataset.theme = theme;
        const meta = document.getElementById("theme-color");
        if (meta) {
          meta.setAttribute(
            "content",
            theme === "dark" ? "#0E1419" : "#F4F1EA",
          );
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {locale === "es" ? "Saltar al contenido" : "Skip to content"}
    </a>
    <Header locale={locale} page={page} slug={slug} homeEntry={homeEntry} />
    <main class="page-shell" id="main">
      <slot />
    </main>
    <Footer locale={locale} page={page} slug={slug} homeEntry={homeEntry} />
  </body>
</html>
