---
import { SOCIAL_LINKS } from "@/constants/socials";
---

<ul class="social-links" aria-label="Social links">
  {
    SOCIAL_LINKS.map((link) => (
      <li>
        <a
          class="chip"
          href={link.href}
          target="_blank"
          rel="noreferrer"
          aria-label={link.label}
        >
          {link.label}
        </a>
      </li>
    ))
  }
</ul>
