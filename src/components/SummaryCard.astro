---
import { Image } from "astro:assets";
import ProfilePhoto from "@/assets/profile_photo.png";
import { calculateImageDimensions } from "@/utils/imageDimensions";
import SocialLinks from "@/components/SocialLinks.astro";

const imageDimensions = calculateImageDimensions(300, { aspectRatio: "4:5" });
---

<section class="card card--accent summary-card">
  <Image
    src={ProfilePhoto}
    alt="Profile photo"
    class="summary-card__profile-photo"
    {...imageDimensions}
  />
  <h2>Brahian Calo</h2>
  <p>Software Technical Leader from Uruguay</p>
  <SocialLinks />
</section>

<style lang="scss">
  @use "../assets/styles/index" as *;

  .summary-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: space(md);

    &__profile-photo {
      margin-bottom: space(xs);
    }

    p {
      text-align: center;
    }
  }
</style>
