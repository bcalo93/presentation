---
import type { HTMLAttributes, SvgComponent } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  asset: SvgComponent;
  srLabel?: string;
}

const { asset: Asset, srLabel, ...anchorProps } = Astro.props;
---

<div class="nav-item">
  <a {...anchorProps}>
    <Asset aria-label={srLabel} />
  </a>
</div>

<style lang="scss">
  @use "../assets/styles/index" as *;

  $duration: 0.3s;
  $delay: 0.15s;

  .nav-item {
    a {
      display: flex;
      align-items: center;
      justify-content: center;
      padding: space(xs);
      border-radius: radius(pill);
      transition:
        transform $duration ease $delay,
        background-color $duration ease $delay;
    }

    a:hover {
      transform: scale(1.3, 1.3);
      background-color: color(surface-alt);
    }
  }
</style>
