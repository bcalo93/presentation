---
import { render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  homeEntry: CollectionEntry<"home">;
  project: CollectionEntry<"projects">;
  backHref: string;
}

const { homeEntry, project, backHref } = Astro.props;
const { Content } = await render(project);
const copy = homeEntry.data.projectPage;
const hasNextStep = Boolean(project.data.nextStep);
---

<article class="case-study">
  <a class="case-study__back-link" href={backHref}>{copy.backToProjects}</a>

  <header class="case-study__hero">
    <div class="case-study__hero-copy">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h1>{project.data.title}</h1>
      <p class="case-study__summary">{project.data.summary}</p>
    </div>

    <div class="case-study__meta card">
      <div>
        <p class="case-study__label">{copy.statusLabel}</p>
        <p>{project.data.status}</p>
      </div>
      <div>
        <p class="case-study__label">{copy.repositoryLabel}</p>
        <p>
          {
            project.data.repositoryHref ? (
              <a
                href={project.data.repositoryHref}
                target="_blank"
                rel="noreferrer"
              >
                {project.data.repositoryLabel}
              </a>
            ) : (
              project.data.repositoryLabel
            )
          }
        </p>
      </div>
      <div>
        <p class="case-study__label">{copy.stackLabel}</p>
        <div class="pill-list">
          {project.data.stack.map((item) => <span>{item}</span>)}
        </div>
      </div>
    </div>
  </header>

  <section class="section case-study__section">
    <div class="section__header">
      <p class="eyebrow">{copy.problem.eyebrow}</p>
      <h2>{copy.problem.title}</h2>
    </div>
    <div class="card case-study__body">
      <p>{project.data.problem}</p>
      <Content />
    </div>
  </section>

  <section class="section case-study__section">
    <div class="section__header">
      <p class="eyebrow">{copy.constraints.eyebrow}</p>
      <h2>{copy.constraints.title}</h2>
    </div>
    <div class="card">
      <ul class="case-study__list">
        {project.data.constraints.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section case-study__section">
    <div class="section__header">
      <p class="eyebrow">{copy.architecture.eyebrow}</p>
      <h2>{copy.architecture.title}</h2>
    </div>
    <div class="card">
      <ul class="case-study__list">
        {project.data.architecture.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="section case-study__section">
    <div class="section__header">
      <p class="eyebrow">{copy.tradeoffs.eyebrow}</p>
      <h2>{copy.tradeoffs.title}</h2>
    </div>
    <div class="card">
      <ul class="case-study__list">
        {project.data.tradeoffs.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <section
    class:list={[
      "section",
      "case-study__grid",
      !hasNextStep && "case-study__grid--single",
    ]}
  >
    <div class="card">
      <p class="eyebrow">{copy.status.eyebrow}</p>
      <h2>{copy.status.title}</h2>
      <p>{project.data.statusNote}</p>
    </div>
    {
      hasNextStep && (
        <div class="card">
          <p class="eyebrow">{project.data.nextStepsTitle}</p>
          <h2>{copy.nextStepsHeading}</h2>
          <p>{project.data.nextStep}</p>
          <ul class="case-study__list">
            {project.data.roadmap.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      )
    }
  </section>

  {
    project.data.links.length > 0 && (
      <section class="section case-study__section">
        <div class="section__header">
          <p class="eyebrow">{copy.links.eyebrow}</p>
          <h2>{copy.links.title}</h2>
        </div>
        <div class="card case-study__links">
          {project.data.links.map((link) => (
            <a
              class="button-secondary"
              href={link.href}
              target="_blank"
              rel="noreferrer"
            >
              {link.label}
            </a>
          ))}
        </div>
      </section>
    )
  }
</article>

<style lang="scss">
  .case-study {
    display: grid;
    gap: 1.5rem;
  }

  .case-study__back-link {
    display: inline-flex;
    width: fit-content;
    color: var(--color-primary);
    font-weight: 600;
  }

  .case-study__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(20rem, 1fr);
    gap: 1.5rem;
    align-items: start;
    padding: 1rem 0 2rem;
  }

  .case-study__hero-copy {
    display: grid;
    gap: 1rem;
    max-width: 48rem;
  }

  .case-study__summary {
    font-size: 1.1rem;
  }

  .case-study__meta {
    display: grid;
    gap: 1.25rem;
  }

  .case-study__label {
    margin-bottom: 0.35rem;
    color: var(--color-text);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .case-study__body {
    display: grid;
    gap: 1rem;
  }

  .case-study__body :global(p) + :global(p) {
    margin-top: 1rem;
  }

  .case-study__list {
    display: grid;
    gap: 0.85rem;
    padding-left: 1.1rem;
    list-style: disc;
  }

  .case-study__list li {
    color: var(--color-text-muted);
  }

  .case-study__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .case-study__grid .card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }

  .case-study__grid--single {
    grid-template-columns: 1fr;
  }

  .case-study__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  @media (max-width: 860px) {
    .case-study__hero,
    .case-study__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
