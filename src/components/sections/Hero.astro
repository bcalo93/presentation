---
import { Image } from "astro:assets";
import ProfilePhoto from "@/assets/profile_photo.png";
import SocialLinks from "@/components/SocialLinks.astro";

interface Props {
  copy: {
    role: string;
    lede: string;
    primaryCta: string;
    secondaryCta: string;
    portraitAlt: string;
  };
}

const { copy } = Astro.props;
---

<section class="section hero" id="home">
  <div class="hero__content">
    <div class="hero__copy">
      <p class="hero__role">{copy.role}</p>
      <h1>Brahian Calo</h1>
      <p class="hero__lede">{copy.lede}</p>
      <div class="hero__cta">
        <a class="button" href="#contact">{copy.primaryCta}</a>
        <a class="button-secondary" href="#projects">{copy.secondaryCta}</a>
      </div>
      <SocialLinks />
    </div>
    <div class="hero__media">
      <div class="hero__frame">
        <Image
          src={ProfilePhoto}
          alt={copy.portraitAlt}
          width={371}
          height={464}
          sizes="(max-width: 900px) 100vw, 371px"
        />
      </div>
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../assets/styles/index" as *;

  .hero__content {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: space(2xl) space(3xl);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: space(xl);
    max-width: 42rem;
  }

  .hero__role {
    font-family: $font-mono;
    font-size: var(--text-sm);
    color: color(text-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .hero__role::before {
    content: "// ";
    color: color(accent);
  }

  .hero h1 {
    font-family: $font-display;
    font-size: var(--text-hero);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
  }

  .hero__lede {
    font-size: var(--text-lede);
    max-width: 38rem;
  }

  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: space(md);
  }

  .hero__media {
    position: relative;
    padding: space(2xl) space(2xl) space(2xl) 0;
    justify-self: end;
  }

  .hero__media::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, color(border) 1px, transparent 1px),
      linear-gradient(to bottom, color(border) 1px, transparent 1px);
    background-size: 1.5rem 1.5rem;
    background-position: top left;
    opacity: 0.5;
  }

  .hero__frame {
    position: relative;
    background: color(surface-subtle);
  }

  .hero__frame::before {
    content: "";
    position: absolute;
    inset: 0;
    border: 1px solid color(accent);
    transform: translate(0.75rem, 0.75rem);
    pointer-events: none;
  }

  .hero__frame::after {
    content: "+";
    position: absolute;
    top: -1rem;
    left: -1rem;
    color: color(accent);
    font-family: $font-mono;
    font-size: 1.25rem;
    line-height: 1;
  }

  .hero__media::after {
    content: "+";
    position: absolute;
    right: 0.25rem;
    bottom: 0.5rem;
    color: color(accent);
    font-family: $font-mono;
    font-size: 1.25rem;
    line-height: 1;
  }

  .hero__frame img {
    display: block;
    width: 100%;
    height: auto;
  }

  @include respond-below(lg) {
    .hero__content {
      grid-template-columns: 1fr;
    }

    .hero__media {
      max-width: 24rem;
      justify-self: start;
    }
  }
</style>
