---
import { Image } from "astro:assets";
import ProfilePhoto from "@/assets/profile_photo.png";
import SocialLinks from "@/components/SocialLinks.astro";

interface Props {
  copy: {
    role: string;
    lede: string;
    primaryCta: string;
    secondaryCta: string;
    portraitAlt: string;
  };
}

const { copy } = Astro.props;
---

<section class="section hero" id="home">
  <div class="hero__content">
    <div class="hero__copy">
      <p class="eyebrow">{copy.role}</p>
      <h1>Brahian Calo</h1>
      <p class="hero__lede">{copy.lede}</p>
      <div class="cta-row">
        <a class="button" href="#contact">{copy.primaryCta}</a>
        <a class="button-secondary" href="#projects">{copy.secondaryCta}</a>
      </div>
      <SocialLinks />
    </div>
    <div class="hero__photo card">
      <Image
        src={ProfilePhoto}
        alt={copy.portraitAlt}
        width={371}
        height={464}
        sizes="(max-width: 900px) 100vw, 371px"
      />
    </div>
  </div>
</section>

<style lang="scss">
  @use "../../assets/styles/index" as *;

  .hero__content {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(280px, 371px);
    gap: space(2xl);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: space(xl);
    max-width: 42rem;
  }

  .hero__lede {
    font-size: 1.125rem;
    max-width: 38rem;
  }

  .hero__photo {
    padding: space(sm);
    background:
      linear-gradient(
        180deg,
        rgba(37, 99, 235, 0.08),
        rgba(20, 184, 166, 0.04)
      ),
      color(surface);
  }

  .hero__photo img {
    border-radius: radius(sm);
  }

  @include respond-below(lg) {
    .hero__content {
      grid-template-columns: 1fr;
    }

    .hero__photo {
      max-width: 24rem;
    }
  }
</style>
