---
import type { CollectionEntry } from 'astro:content';

interface Props {
  experiences: CollectionEntry<'experience'>[];
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
    currentLabel: string;
    transitionLabel: string;
  };
}

const { experiences, copy } = Astro.props;
const items = [...experiences].reverse();
---

<section class="section" id="timeline" aria-labelledby="timeline-title">
  <div class="section__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="timeline-title">{copy.title}</h2>
    {copy.description && <p>{copy.description}</p>}
  </div>

  <div class="timeline-rail card">
    {items.map((experience, index) => (
      <article class="timeline-rail__item">
        <div class="timeline-rail__marker" aria-hidden="true">
          <span></span>
          {index < items.length - 1 && <i></i>}
        </div>
        <div class="timeline-rail__content">
          <div class="timeline-rail__eyebrow">
            <span>{experience.data.timelineLabel}</span>
            <span>{index === items.length - 1 ? copy.currentLabel : copy.transitionLabel}</span>
          </div>
          <h3>{experience.data.company}</h3>
          <p>{experience.data.roles.join(' • ')}</p>
          {experience.data.impactMetrics.length > 0 && (
            <dl class="timeline-rail__metrics">
              {experience.data.impactMetrics.map((metric) => (
                <div>
                  <dt>{metric.value}</dt>
                  <dd>{metric.label}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </article>
    ))}
  </div>
</section>

<style lang="scss">
  .timeline-rail {
    display: grid;
    gap: 1.5rem;
  }

  .timeline-rail__item {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 1rem;
  }

  .timeline-rail__marker {
    display: grid;
    justify-items: center;
    grid-template-rows: auto 1fr;
    gap: 0.5rem;
  }

  .timeline-rail__marker span {
    width: 0.9rem;
    height: 0.9rem;
    border: 2px solid var(--color-primary);
    border-radius: 999px;
    background: var(--color-surface);
  }

  .timeline-rail__marker i {
    width: 1px;
    background: var(--color-border);
  }

  .timeline-rail__content {
    display: grid;
    gap: 0.85rem;
    padding-bottom: 0.5rem;
  }

  .timeline-rail__eyebrow {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .timeline-rail__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.85rem;
  }

  .timeline-rail__metrics div {
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface-alt);
  }

  .timeline-rail__metrics dt {
    color: var(--color-text);
    font-weight: 700;
  }

  .timeline-rail__metrics dd {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .timeline-rail__item {
      grid-template-columns: 2rem minmax(0, 1fr);
    }
  }
</style>
