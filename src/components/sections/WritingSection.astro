---
import type { CollectionEntry } from 'astro:content';
import { getWritingPath } from '@/i18n/config';
import type { Locale } from '@/i18n/config';

interface Props {
  locale: Locale;
  entries: CollectionEntry<'writing'>[];
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
    readingTimeLabel: string;
    publishedLabel: string;
    readArticleLabel: string;
    viewAllLabel: string;
  };
}

const { locale, entries, copy } = Astro.props;
---

<section class="section" id="writing" aria-labelledby="writing-title">
  <div class="section__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="writing-title">{copy.title}</h2>
    {copy.description && <p>{copy.description}</p>}
  </div>

  <div class="card-grid writing-grid">
    {entries.map((entry) => (
      <article class="card writing-card">
        <div class="writing-card__meta">
          <span>{copy.publishedLabel}: {entry.data.publishedOn}</span>
          <span>{copy.readingTimeLabel}: {entry.data.readingTime}</span>
        </div>
        <h3>{entry.data.title}</h3>
        <p>{entry.data.summary}</p>
        <div class="pill-list">
          {entry.data.tags.map((tag) => <span>{tag}</span>)}
        </div>
        <a class="button-secondary" href={getWritingPath(locale, entry.data.path)}>{copy.readArticleLabel}</a>
      </article>
    ))}
  </div>

  <div class="writing-section__actions">
    <a class="button" href={getWritingPath(locale)}>{copy.viewAllLabel}</a>
  </div>
</section>

<style lang="scss">
  .writing-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .writing-card {
    display: grid;
    gap: 1rem;
  }

  .writing-card__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .writing-section__actions {
    margin-top: 1.5rem;
  }

  @media (max-width: 820px) {
    .writing-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
