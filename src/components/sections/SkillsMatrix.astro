---
interface Props {
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
    groups: Array<{
      title: string;
      items: string[];
    }>;
  };
}

const { copy } = Astro.props;
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="section__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="skills-title">{copy.title}</h2>
    {copy.description && <p>{copy.description}</p>}
  </div>

  <div class="card-grid skills-grid">
    {
      copy.groups.map((group) => (
        <article class="card skills-card">
          <h3>{group.title}</h3>
          <div class="pill-list">
            {group.items.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </article>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use "../../assets/styles/index" as *;

  .skills-grid {
    @include responsive-grid(2, md);
  }

  .skills-card {
    display: grid;
    gap: space(md);
  }
</style>
