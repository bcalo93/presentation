---
interface Props {
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
    groups: Array<{
      title: string;
      items: string[];
    }>;
  };
}

const { copy } = Astro.props;
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <div class="section__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="skills-title">{copy.title}</h2>
    {copy.description && <p>{copy.description}</p>}
  </div>

  <div class="card-grid skills-grid">
    {copy.groups.map((group) => (
      <article class="card skills-card">
        <h3>{group.title}</h3>
        <div class="pill-list">
          {group.items.map((item) => <span>{item}</span>)}
        </div>
      </article>
    ))}
  </div>
</section>

<style lang="scss">
  .skills-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .skills-card {
    display: grid;
    gap: 1rem;
  }

  @media (max-width: 820px) {
    .skills-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
