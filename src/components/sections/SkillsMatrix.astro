---
import SectionHeading from "@/components/SectionHeading.astro";

interface Props {
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
    groups: Array<{
      title: string;
      items: string[];
    }>;
  };
}

const { copy } = Astro.props;
---

<section class="section" id="skills" aria-labelledby="skills-title">
  <SectionHeading
    eyebrow={copy.eyebrow}
    title={copy.title}
    description={copy.description}
    index="03"
    id="skills-title"
  />

  <ul class="skills-matrix">
    {
      copy.groups.map((group) => (
        <li class="skills-matrix__row">
          <h3 class="skills-matrix__title">{group.title}</h3>
          <p class="skills-matrix__items">{group.items.join(", ")}</p>
        </li>
      ))
    }
  </ul>
</section>

<style lang="scss">
  @use "../../assets/styles/index" as *;

  .skills-matrix {
    list-style: none;
    border-top: 1px solid color(border);
  }

  .skills-matrix__row {
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) minmax(0, 1fr);
    gap: space(2xl);
    padding: space(lg) 0;
    border-bottom: 1px solid color(border);
  }

  .skills-matrix__title {
    font-family: $font-display;
    font-size: var(--text-h3);
  }

  .skills-matrix__items {
    color: color(text-muted);
    line-height: 1.8;
  }

  @include respond-below(sm) {
    .skills-matrix__row {
      grid-template-columns: 1fr;
      gap: space(2xs);
    }
  }
</style>
