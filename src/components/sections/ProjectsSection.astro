---
import type { CollectionEntry } from "astro:content";
import { getProjectPath } from "@/i18n/config";
import type { Locale } from "@/i18n/config";

interface Props {
  projects: CollectionEntry<"projects">[];
  locale: Locale;
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
    problemLabel: string;
    repositoryLabel: string;
    nextStepLabel: string;
    readCaseStudyLabel: string;
  };
}

const { projects, locale, copy } = Astro.props;
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="section__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="projects-title">{copy.title}</h2>
    {copy.description && <p>{copy.description}</p>}
  </div>

  <div class="card-grid projects-grid">
    {
      projects.map((project) => (
        <article class="card project-card">
          <div class="project-card__header">
            <h3>{project.data.title}</h3>
            <span>{project.data.status}</span>
          </div>
          <div class="project-card__overview">
            <p>{project.data.summary}</p>
            <div class="project-card__meta">
              <p>
                <strong>{copy.problemLabel}:</strong> {project.data.problem}
              </p>
              <p>
                <strong>{copy.repositoryLabel}:</strong>{" "}
                {project.data.repositoryHref ? (
                  <a
                    href={project.data.repositoryHref}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {project.data.repositoryLabel}
                  </a>
                ) : (
                  project.data.repositoryLabel
                )}
              </p>
            </div>
          </div>
          <div class="pill-list">
            {project.data.stack.map((item) => (
              <span>{item}</span>
            ))}
          </div>
          <div class="project-card__body">
            <ul class="project-card__highlights">
              {project.data.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            {project.data.nextStep && (
              <p class="project-card__next-step">
                <strong>{copy.nextStepLabel}:</strong> {project.data.nextStep}
              </p>
            )}
          </div>
          <div class="project-card__actions">
            <a
              class="button-secondary"
              href={getProjectPath(locale, project.data.path)}
            >
              {copy.readCaseStudyLabel}
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style lang="scss">
  .projects-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
  }

  .project-card__overview,
  .project-card__meta,
  .project-card__body {
    display: grid;
    gap: 0.9rem;
  }

  .project-card__overview {
    align-content: start;
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .project-card__header span {
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: var(--color-surface-alt);
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .project-card__highlights {
    display: grid;
    gap: 0.7rem;
    padding-left: 1rem;
    list-style: disc;
  }

  .project-card__highlights li {
    color: var(--color-text-muted);
  }

  .project-card__body {
    align-content: start;
  }

  .project-card__next-step {
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-border);
  }

  .project-card__actions {
    display: flex;
    justify-content: flex-start;
    margin-top: auto;
  }

  @media (max-width: 820px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
