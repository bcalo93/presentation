---
const projects = [
  {
    title: 'Portfolio',
    problem: 'Present a professional profile through a fast, content-driven site that communicates technical depth and credibility.',
    status: 'Active',
    stack: ['Astro', 'TypeScript', 'Sass', 'SEO'],
    repository: 'This repository',
    highlights: [
      'Single-page architecture optimized for hiring flows.',
      'Responsive sections with strong information hierarchy.',
      'Prepared for future bilingual content without overbuilding the MVP.',
    ],
    nextStep: 'Move content into Astro Content Collections and add project detail pages.',
  },
  {
    title: 'Splitit',
    problem: 'Model shared expenses clearly in a multiplatform app with a clean product foundation.',
    status: 'WIP',
    stack: ['Kotlin Multiplatform', 'Shared logic', 'Product modeling'],
    repository: 'Private / in progress',
    highlights: [
      'Focused on multiplatform architecture and reusable domain logic.',
      'Explores expense-sharing workflows and product-level tradeoffs.',
      'Useful as a case study in how features evolve from model design.',
    ],
    nextStep: 'Publish a full case study with screenshots, architecture notes, and roadmap.',
  },
];
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="section__header">
    <p class="eyebrow">Projects</p>
    <h2 id="projects-title">Projects that show engineering intent, not only output</h2>
    <p>
      Even WIP work is valuable when it explains the problem, stack, current scope, and next decision.
    </p>
  </div>

  <div class="card-grid projects-grid">
    {projects.map((project) => (
      <article class="card project-card">
        <div class="project-card__header">
          <h3>{project.title}</h3>
          <span>{project.status}</span>
        </div>
        <p><strong>Problem:</strong> {project.problem}</p>
        <p><strong>Repository:</strong> {project.repository}</p>
        <div class="pill-list">
          {project.stack.map((item) => <span>{item}</span>)}
        </div>
        <ul class="project-card__highlights">
          {project.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
        <p><strong>Next step:</strong> {project.nextStep}</p>
      </article>
    ))}
  </div>
</section>

<style lang="scss">
  .projects-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .project-card {
    display: grid;
    gap: 1rem;
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .project-card__header span {
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: var(--color-surface-alt);
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .project-card__highlights {
    display: grid;
    gap: 0.7rem;
    padding-left: 1rem;
    list-style: disc;
  }

  .project-card__highlights li {
    color: var(--color-text-muted);
  }

  @media (max-width: 820px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
