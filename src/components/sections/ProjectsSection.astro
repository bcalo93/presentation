---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="section__header">
    <p class="eyebrow">Projects</p>
    <h2 id="projects-title">Projects that show engineering intent, not only output</h2>
    <p>
      Even WIP work is valuable when it explains the problem, stack, current scope, and next decision.
    </p>
  </div>

  <div class="card-grid projects-grid">
    {projects.map((project) => (
      <article class="card project-card">
        <div class="project-card__header">
          <h3>{project.data.title}</h3>
          <span>{project.data.status}</span>
        </div>
        <p><strong>Problem:</strong> {project.data.problem}</p>
        <p><strong>Repository:</strong> {project.data.repository}</p>
        <div class="pill-list">
          {project.data.stack.map((item) => <span>{item}</span>)}
        </div>
        <ul class="project-card__highlights">
          {project.data.highlights.map((highlight) => <li>{highlight}</li>)}
        </ul>
        <p><strong>Next step:</strong> {project.data.nextStep}</p>
      </article>
    ))}
  </div>
</section>

<style lang="scss">
  .projects-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .project-card {
    display: grid;
    gap: 1rem;
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }

  .project-card__header span {
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: var(--color-surface-alt);
    color: var(--color-primary);
    font-size: 0.875rem;
    font-weight: 700;
  }

  .project-card__highlights {
    display: grid;
    gap: 0.7rem;
    padding-left: 1rem;
    list-style: disc;
  }

  .project-card__highlights li {
    color: var(--color-text-muted);
  }

  @media (max-width: 820px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
