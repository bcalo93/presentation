---
import type { CollectionEntry } from "astro:content";
import { getProjectPath } from "@/i18n/config";
import type { Locale } from "@/i18n/config";

interface Props {
  projects: CollectionEntry<"projects">[];
  locale: Locale;
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
    problemLabel: string;
    repositoryLabel: string;
    nextStepLabel: string;
    readCaseStudyLabel: string;
  };
}

const { projects, locale, copy } = Astro.props;
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="section__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="projects-title">{copy.title}</h2>
    {copy.description && <p>{copy.description}</p>}
  </div>

  <div class="card-grid projects-grid">
    {
      projects.map((project) => (
        <article class="card project-card">
          <div class="project-card__header">
            <h3>{project.data.title}</h3>
            <span class="chip chip--accent">{project.data.status}</span>
          </div>
          <div class="project-card__overview">
            <p>{project.data.summary}</p>
            <div class="project-card__meta">
              <p>
                <strong>{copy.problemLabel}:</strong> {project.data.problem}
              </p>
              <p>
                <strong>{copy.repositoryLabel}:</strong>{" "}
                {project.data.repositoryHref ? (
                  <a
                    href={project.data.repositoryHref}
                    target="_blank"
                    rel="noreferrer"
                  >
                    {project.data.repositoryLabel}
                  </a>
                ) : (
                  project.data.repositoryLabel
                )}
              </p>
            </div>
          </div>
          <div class="pill-list">
            {project.data.stack.map((item) => (
              <span>{item}</span>
            ))}
          </div>
          <div class="project-card__body">
            <ul class="list-muted project-card__highlights">
              {project.data.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            {project.data.nextStep && (
              <p class="project-card__next-step">
                <strong>{copy.nextStepLabel}:</strong> {project.data.nextStep}
              </p>
            )}
          </div>
          <div class="project-card__actions">
            <a
              class="button-secondary"
              href={getProjectPath(locale, project.data.path)}
            >
              {copy.readCaseStudyLabel}
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use "../../assets/styles/index" as *;

  a:hover {
    color: color(primary);
  }

  .projects-grid {
    @include responsive-grid(2, md);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: space(md);
    height: 100%;
  }

  .project-card__overview,
  .project-card__meta,
  .project-card__body {
    display: grid;
    gap: space(sm);
  }

  .project-card__overview {
    align-content: start;
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    gap: space(md);
    align-items: center;
  }

  .project-card__body {
    align-content: start;
  }

  .project-card__next-step {
    padding-top: space(sm);
    border-top: 1px solid color(border);
  }

  .project-card__actions {
    display: flex;
    justify-content: flex-start;
    margin-top: auto;
  }
</style>
