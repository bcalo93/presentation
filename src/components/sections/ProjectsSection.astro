---
import type { CollectionEntry } from "astro:content";
import { getProjectPath } from "@/i18n/config";
import type { Locale } from "@/i18n/config";

interface Props {
  projects: CollectionEntry<"projects">[];
  locale: Locale;
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
    repositoryLabel: string;
    readCaseStudyLabel: string;
  };
}

const { projects, locale, copy } = Astro.props;
---

<section class="section" id="projects" aria-labelledby="projects-title">
  <div class="section__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="projects-title">{copy.title}</h2>
    {copy.description && <p>{copy.description}</p>}
  </div>

  <div class="card-grid projects-grid">
    {
      projects.map((project) => {
        const highlights = project.data.highlights.slice(0, 3);

        return (
          <article class="card project-card">
            <div class="project-card__header">
              <h3>{project.data.title}</h3>
              <span class="chip chip--accent">{project.data.status}</span>
            </div>
            <p class="project-card__summary">{project.data.summary}</p>
            <div class="pill-list">
              {project.data.stack.map((item) => (
                <span>{item}</span>
              ))}
            </div>
            <ul class="list-muted project-card__highlights">
              {highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <div class="project-card__actions">
              {project.data.repositoryHref && (
                <a
                  class="button-secondary"
                  href={project.data.repositoryHref}
                  target="_blank"
                  rel="noreferrer"
                >
                  {copy.repositoryLabel}
                </a>
              )}
              <a
                class="button-secondary"
                href={getProjectPath(locale, project.data.path)}
              >
                {copy.readCaseStudyLabel}
              </a>
            </div>
          </article>
        );
      })
    }
  </div>
</section>

<style lang="scss">
  @use "../../assets/styles/index" as *;

  a:hover {
    color: color(primary);
  }

  .projects-grid {
    @include responsive-grid(2, md);
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: space(md);
    height: 100%;
  }

  .project-card__header {
    display: flex;
    justify-content: space-between;
    gap: space(md);
    align-items: center;
  }

  .project-card__summary {
    align-content: start;
  }

  .project-card__highlights {
    align-content: start;
  }

  .project-card__actions {
    display: flex;
    flex-wrap: wrap;
    gap: space(sm);
    margin-top: auto;
  }
</style>
