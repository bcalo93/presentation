---
interface Props {
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
    emailCta: string;
    linkedinCta: string;
    links: Array<{
      label: string;
      value: string;
    }>;
  };
}

const { copy } = Astro.props;

const hrefByLabel: Record<string, string> = {
  Email: "mailto:bcalo93@gmail.com",
  LinkedIn: "https://www.linkedin.com/in/brahian-calo-suhr/",
  GitHub: "https://github.com/bcalo93",
};
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="section__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="contact-title">{copy.title}</h2>
    {copy.description && <p>{copy.description}</p>}
  </div>

  <div class="card contact-card">
    <div class="cta-row">
      <a class="button" href="mailto:bcalo93@gmail.com">{copy.emailCta}</a>
      <a
        class="button-secondary"
        href="https://www.linkedin.com/in/brahian-calo-suhr/"
        target="_blank"
        rel="noreferrer">{copy.linkedinCta}</a
      >
    </div>

    <dl class="contact-list">
      {
        copy.links.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>
              {hrefByLabel[item.label] ? (
                <a
                  href={hrefByLabel[item.label]}
                  target={
                    hrefByLabel[item.label]?.startsWith("http")
                      ? "_blank"
                      : undefined
                  }
                  rel={
                    hrefByLabel[item.label]?.startsWith("http")
                      ? "noreferrer"
                      : undefined
                  }
                >
                  {item.value}
                </a>
              ) : (
                <span>{item.value}</span>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style lang="scss">
  @use "../../assets/styles/index" as *;

  .contact-card {
    display: grid;
    gap: space(2xl);
  }

  .contact-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: space(md) space(xl);
  }

  .contact-list div {
    padding-top: space(md);
    border-top: 1px solid color(border);
  }

  .contact-list dt {
    margin-bottom: space(2xs);
    color: color(text);
    font-weight: 700;
  }

  .contact-list dd {
    margin: 0;
    color: color(text-muted);
  }

  .contact-list a:hover {
    color: color(primary);
  }

  @include respond-below(sm) {
    .contact-list {
      grid-template-columns: 1fr;
    }
  }
</style>
