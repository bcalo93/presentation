---
import SectionHeading from "@/components/SectionHeading.astro";

interface Props {
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
    emailCta: string;
    linkedinCta: string;
    links: Array<{
      label: string;
      value: string;
    }>;
  };
}

const { copy } = Astro.props;

const hrefByLabel: Record<string, string> = {
  Email: "mailto:bcalo93@gmail.com",
  LinkedIn: "https://www.linkedin.com/in/brahian-calo-suhr/",
  GitHub: "https://github.com/bcalo93",
};
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <SectionHeading
    eyebrow={copy.eyebrow}
    title={copy.title}
    description={copy.description}
    index="05"
    id="contact-title"
  />

  <div class="contact-close">
    <a class="button" href="mailto:bcalo93@gmail.com">{copy.emailCta}</a>

    <ul class="contact-links">
      <li>
        <a
          class="contact-link"
          href="https://www.linkedin.com/in/brahian-calo-suhr/"
          target="_blank"
          rel="noreferrer">{copy.linkedinCta}</a
        >
      </li>
      {
        copy.links.map((item) => {
          const href = hrefByLabel[item.label];

          return (
            <li>
              {href ? (
                <a
                  class="contact-link"
                  href={href}
                  target={href.startsWith("http") ? "_blank" : undefined}
                  rel={href.startsWith("http") ? "noreferrer" : undefined}
                >
                  {item.value}
                </a>
              ) : (
                <span class="contact-link contact-link--static">
                  {item.value}
                </span>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style lang="scss">
  @use "../../assets/styles/index" as *;

  .contact-close {
    display: grid;
    gap: space(3xl);
    justify-items: start;
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: space(sm) space(2xl);
    list-style: none;
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: color(text-muted);
    text-decoration: underline;
    text-decoration-color: color(border);
    text-underline-offset: 0.3em;
  }

  .contact-link:hover,
  .contact-link:focus-visible {
    color: color(accent);
    text-decoration-color: color(accent);
  }

  .contact-link--static {
    cursor: default;
  }
</style>
