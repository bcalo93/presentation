---
import SectionHeading from "@/components/SectionHeading.astro";
import SocialIcon from "@/components/SocialIcon.astro";

interface Props {
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
    emailCta: string;
    links: Array<{
      label: string;
      value: string;
    }>;
  };
}

const { copy } = Astro.props;

const hrefByLabel: Record<string, string> = {
  Email: "mailto:bcalo93@gmail.com",
  LinkedIn: "https://www.linkedin.com/in/brahian-calo-suhr/",
  GitHub: "https://github.com/bcalo93",
};

const iconByLabel: Record<string, "github" | "linkedin" | "email"> = {
  Email: "email",
  LinkedIn: "linkedin",
  GitHub: "github",
};
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <SectionHeading
    eyebrow={copy.eyebrow}
    title={copy.title}
    description={copy.description}
    index="05"
    id="contact-title"
  />

  <div class="contact-close">
    <a class="button" href="mailto:bcalo93@gmail.com">{copy.emailCta}</a>

    <ul class="contact-links">
      {
        copy.links.map((item) => {
          const href = hrefByLabel[item.label];
          const icon = iconByLabel[item.label];

          if (!href || !icon) {
            return (
              <li>
                <span class="contact-link contact-link--static">
                  {item.value}
                </span>
              </li>
            );
          }

          return (
            <li>
              <a
                class="contact-link"
                href={href}
                target={href.startsWith("http") ? "_blank" : undefined}
                rel={href.startsWith("http") ? "noreferrer" : undefined}
                aria-label={item.label}
                title={item.value}
              >
                <SocialIcon name={icon} />
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style lang="scss">
  @use "../../assets/styles/index" as *;

  .contact-close {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: space(md) space(xl);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: space(md);
    list-style: none;
  }

  .contact-link {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: color(text-muted);
    transition: color 0.2s ease;
  }

  .contact-link :global(svg) {
    width: 1.5rem;
    height: 1.5rem;
  }

  a.contact-link:hover,
  a.contact-link:focus-visible {
    color: color(accent);
  }

  .contact-link--static {
    cursor: default;
  }
</style>
