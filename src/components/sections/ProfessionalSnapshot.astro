---
interface Props {
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
    highlights: string[];
  };
}

const { copy } = Astro.props;
---

<section class="section" aria-labelledby="snapshot-title">
  <div class="section__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="snapshot-title">{copy.title}</h2>
    {copy.description && <p>{copy.description}</p>}
  </div>

  <div class="card">
    <div class="pill-list">
      {copy.highlights.map((item) => <span>{item}</span>)}
    </div>
  </div>
</section>
