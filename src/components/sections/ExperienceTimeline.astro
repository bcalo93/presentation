---
const experiences = [
  {
    company: 'Mercado Libre',
    period: '2022 - Present',
    roles: ['Technical Lead', 'Senior Frontend Developer'],
    summary:
      'Led frontend initiatives while staying close to implementation, architecture, delivery quality, and practical AI adoption inside engineering workflows.',
    highlights: [
      'Improved team practices, code quality, and delivery consistency.',
      'Drove early AI usage to reduce repetitive work and support better engineering decisions.',
      'Worked across cross-functional teams on frontend architecture and product execution.',
    ],
    stack: ['React', 'TypeScript', 'JavaScript', 'Architecture', 'AI workflows'],
  },
  {
    company: 'Altimetrik',
    period: '2015 - June 2022',
    roles: ['Frontend Developer'],
    summary:
      'Built enterprise frontend solutions in constrained platform environments, with emphasis on maintainable components and business-critical workflows.',
    highlights: [
      'Delivered component-based frontend development on top of Salesforce ecosystems.',
      'Worked on complex interfaces with a strong focus on maintainability.',
      'Strengthened long-term product delivery discipline in enterprise contexts.',
    ],
    stack: ['JavaScript', 'Salesforce', 'Lightning Web Components', 'Frontend architecture'],
  },
];
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="section__header">
    <p class="eyebrow">Experience</p>
    <h2 id="experience-title">Role progression backed by delivery and technical ownership</h2>
    <p>
      The focus is on hands-on leadership, scalable frontend work, and measurable quality improvements.
    </p>
  </div>

  <div class="timeline">
    {experiences.map((experience) => (
      <article class="timeline__item card">
        <div class="timeline__meta">
          <p>{experience.period}</p>
          <h3>{experience.company}</h3>
          <p>{experience.roles.join(' • ')}</p>
        </div>
        <div class="timeline__content">
          <p>{experience.summary}</p>
          <ul class="timeline__highlights">
            {experience.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          <div class="pill-list">
            {experience.stack.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style lang="scss">
  .timeline {
    display: grid;
    gap: 1.25rem;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: 1.5rem;
  }

  .timeline__meta {
    display: grid;
    gap: 0.4rem;
  }

  .timeline__meta p:first-child {
    color: var(--color-primary);
    font-weight: 600;
  }

  .timeline__content {
    display: grid;
    gap: 1rem;
  }

  .timeline__highlights {
    display: grid;
    gap: 0.7rem;
    padding-left: 1rem;
    list-style: disc;
  }

  .timeline__highlights li {
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .timeline__item {
      grid-template-columns: 1fr;
    }
  }
</style>
