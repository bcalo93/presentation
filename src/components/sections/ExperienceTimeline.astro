---
import type { CollectionEntry } from "astro:content";
import SectionHeading from "@/components/SectionHeading.astro";

interface Props {
  experiences: CollectionEntry<"experience">[];
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
  };
}

const { experiences, copy } = Astro.props;
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <SectionHeading
    eyebrow={copy.eyebrow}
    title={copy.title}
    description={copy.description}
    index="02"
    id="experience-title"
  />

  <ol class="timeline">
    {
      experiences.map((experience) => (
        <li class="timeline__item">
          <div class="timeline__meta">
            <span class="timeline__period">{experience.data.period}</span>
            <span class="timeline__company">{experience.data.company}</span>
          </div>
          <div class="timeline__content">
            <h3 class="timeline__roles">{experience.data.roles.join(" · ")}</h3>
            <p class="timeline__summary">{experience.data.summary}</p>
            <ul class="timeline__highlights">
              {experience.data.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <ul class="timeline__stack">
              {experience.data.stack.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style lang="scss">
  @use "../../assets/styles/index" as *;

  .timeline {
    position: relative;
    display: grid;
    gap: space(4xl);
    padding-left: space(4xl);
    list-style: none;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 6px;
    width: 1px;
    background: color(border-strong);
  }

  .timeline__item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(9rem, 15rem) minmax(0, 1fr);
    gap: space(2xl);
  }

  .timeline__item::before {
    content: "";
    position: absolute;
    top: 0.35rem;
    left: calc(-1 * #{space(4xl)});
    width: 0.75rem;
    height: 0.75rem;
    background: color(canvas);
    border: 1px solid color(accent);
    transform: scale(1);
    transition:
      transform 0.2s ease,
      background-color 0.2s ease;
  }

  .timeline__item:hover::before {
    transform: scale(1.4);
    background: color(accent);
  }

  .timeline__meta {
    display: grid;
    align-content: start;
    gap: space(2xs);
  }

  .timeline__period {
    font-family: $font-mono;
    font-size: var(--text-sm);
    color: color(text-muted);
    letter-spacing: 0.04em;
  }

  .timeline__company {
    font-family: $font-mono;
    font-size: var(--text-xs);
    color: color(text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .timeline__content {
    display: grid;
    gap: space(md);
  }

  .timeline__roles {
    font-family: $font-display;
    font-size: var(--text-h3);
  }

  .timeline__summary {
    color: color(text-muted);
  }

  .timeline__highlights {
    display: grid;
    gap: space(sm);
    list-style: none;
  }

  .timeline__highlights li {
    position: relative;
    padding-left: 1.25rem;
    color: color(text-muted);
  }

  .timeline__highlights li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 0.5rem;
    height: 1px;
    background: color(accent);
  }

  .timeline__stack {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    gap: space(2xs) space(sm);
  }

  .timeline__stack li {
    font-family: $font-mono;
    font-size: var(--text-sm);
    color: color(text-muted);
  }

  .timeline__stack li + li::before {
    content: "\00b7";
    margin-right: space(sm);
    color: color(border-strong);
  }

  @include respond-below(sm) {
    .timeline {
      padding-left: space(3xl);
    }

    .timeline__item {
      grid-template-columns: 1fr;
      gap: space(md);
    }
  }
</style>
