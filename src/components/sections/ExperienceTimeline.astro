---
import type { CollectionEntry } from 'astro:content';

interface Props {
  experiences: CollectionEntry<'experience'>[];
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
  };
}

const { experiences, copy } = Astro.props;
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="section__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="experience-title">{copy.title}</h2>
    {copy.description && <p>{copy.description}</p>}
  </div>

  <div class="timeline">
    {experiences.map((experience) => (
      <article class="timeline__item card">
        <div class="timeline__meta">
          <p>{experience.data.period}</p>
          <h3>{experience.data.company}</h3>
          <p>{experience.data.roles.join(' • ')}</p>
        </div>
        <div class="timeline__content">
          <p>{experience.data.summary}</p>
          {experience.data.impactMetrics.length > 0 && (
            <dl class="timeline__metrics">
              {experience.data.impactMetrics.map((metric) => (
                <div>
                  <dt>{metric.value}</dt>
                  <dd>{metric.label}</dd>
                </div>
              ))}
            </dl>
          )}
          <ul class="timeline__highlights">
            {experience.data.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          <div class="pill-list">
            {experience.data.stack.map((item) => <span>{item}</span>)}
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style lang="scss">
  .timeline {
    display: grid;
    gap: 1.25rem;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: 1.5rem;
  }

  .timeline__meta {
    display: grid;
    gap: 0.4rem;
  }

  .timeline__meta p:first-child {
    color: var(--color-primary);
    font-weight: 600;
  }

  .timeline__content {
    display: grid;
    gap: 1rem;
  }

  .timeline__metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 0.85rem;
  }

  .timeline__metrics div {
    padding: 0.9rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface-alt);
  }

  .timeline__metrics dt {
    color: var(--color-text);
    font-weight: 700;
  }

  .timeline__metrics dd {
    margin: 0.35rem 0 0;
    color: var(--color-text-muted);
  }

  .timeline__highlights {
    display: grid;
    gap: 0.7rem;
    padding-left: 1rem;
    list-style: disc;
  }

  .timeline__highlights li {
    color: var(--color-text-muted);
  }

  @media (max-width: 720px) {
    .timeline__item {
      grid-template-columns: 1fr;
    }
  }
</style>
