---
import type { CollectionEntry } from "astro:content";

interface Props {
  experiences: CollectionEntry<"experience">[];
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
  };
}

const { experiences, copy } = Astro.props;
---

<section class="section" id="experience" aria-labelledby="experience-title">
  <div class="section__header">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2 id="experience-title">{copy.title}</h2>
    {copy.description && <p>{copy.description}</p>}
  </div>

  <div class="timeline">
    {
      experiences.map((experience) => (
        <article class="timeline__item card">
          <div class="timeline__meta">
            <p>{experience.data.period}</p>
            <h3>{experience.data.company}</h3>
            <p>{experience.data.roles.join(" • ")}</p>
          </div>
          <div class="timeline__content">
            <p>{experience.data.summary}</p>
            <ul class="list-muted timeline__highlights">
              {experience.data.highlights.map((highlight) => (
                <li>{highlight}</li>
              ))}
            </ul>
            <div class="pill-list">
              {experience.data.stack.map((item) => (
                <span>{item}</span>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style lang="scss">
  @use "../../assets/styles/index" as *;

  .timeline {
    display: grid;
    gap: space(lg);
  }

  .timeline__item {
    display: grid;
    grid-template-columns: minmax(220px, 280px) minmax(0, 1fr);
    gap: space(2xl);
  }

  .timeline__meta {
    display: grid;
    align-items: center;
    gap: space(xs);
  }

  .timeline__meta p:first-child {
    color: color(primary);
    font-weight: 600;
  }

  .timeline__content {
    display: grid;
    gap: space(md);
  }

  @include respond-below(sm) {
    .timeline__item {
      grid-template-columns: 1fr;
    }
  }
</style>
