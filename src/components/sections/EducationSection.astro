---
import type { CollectionEntry } from 'astro:content';

interface Props {
  educationItems: CollectionEntry<'education'>[];
}

const { educationItems } = Astro.props;
---

<section class="section" id="education" aria-labelledby="education-title">
  <div class="section__header">
    <p class="eyebrow">Education</p>
    <h2 id="education-title">Systems engineering foundations applied in practice</h2>
  </div>

  {educationItems.map((item) => (
    <article class="card education-card">
      <h3>{item.data.institution}</h3>
      {item.data.degree && <p class="education-card__degree">{item.data.degree}</p>}
      <p>{item.data.summary}</p>
    </article>
  ))}
</section>

<style lang="scss">
  .education-card {
    max-width: 54rem;
  }

  .education-card__degree {
    margin-bottom: 0.75rem;
    color: var(--color-primary);
    font-weight: 600;
  }
</style>
