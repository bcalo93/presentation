---
import type { CollectionEntry } from "astro:content";
import SectionHeading from "@/components/SectionHeading.astro";

interface Props {
  educationItems: CollectionEntry<"education">[];
  copy: {
    eyebrow: string;
    title: string;
    description?: string;
  };
}

const { educationItems, copy } = Astro.props;
---

<section class="section" id="education" aria-labelledby="education-title">
  <SectionHeading
    eyebrow={copy.eyebrow}
    title={copy.title}
    description={copy.description}
    index="04"
    id="education-title"
  />

  <ul class="education-list">
    {
      educationItems.map((item) => (
        <li class="education-item">
          <h3 class="education-item__institution">{item.data.institution}</h3>
          {item.data.degree && (
            <p class="education-item__degree">{item.data.degree}</p>
          )}
          <p class="education-item__summary">{item.data.summary}</p>
        </li>
      ))
    }
  </ul>
</section>

<style lang="scss">
  @use "../../assets/styles/index" as *;

  .education-list {
    display: grid;
    gap: space(3xl);
    list-style: none;
  }

  .education-item {
    display: grid;
    gap: space(sm);
    max-width: 54rem;
    padding-left: space(lg);
    border-left: 1px solid color(border-strong);
  }

  .education-item__institution {
    font-family: $font-display;
    font-size: var(--text-h3);
  }

  .education-item__degree {
    font-family: $font-mono;
    font-size: var(--text-sm);
    color: color(accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .education-item__summary {
    color: color(text-muted);
  }
</style>
