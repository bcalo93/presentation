---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/i18n/config";

interface Props {
  locale: Locale;
  page: "home" | "project";
  slug?: string;
  homeEntry: CollectionEntry<"home">;
}

const { page, homeEntry } = Astro.props;
const footerCopy = homeEntry.data.footer;
const backHref = page === "home" ? "#home" : "#";
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>{footerCopy.blurb}</p>
    <a href={backHref}>{footerCopy.backToTop}</a>
  </div>
</footer>

<style lang="scss">
  @use "../assets/styles/index" as *;

  .site-footer {
    border-top: 1px solid color(border);
    padding: space(xl) 0 space(3xl);
  }

  .site-footer__inner {
    display: flex;
    justify-content: space-between;
    gap: space(md);
  }

  .site-footer a {
    color: color(primary);
    font-weight: 600;
  }

  @include respond-below(sm) {
    .site-footer__inner {
      flex-direction: column;
    }
  }
</style>
