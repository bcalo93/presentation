---
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/i18n/config";

interface Props {
  locale: Locale;
  page: "home" | "project";
  slug?: string;
  homeEntry: CollectionEntry<"home">;
}

const { page, homeEntry } = Astro.props;
const footerCopy = homeEntry.data.footer;
const backHref = page === "home" ? "#home" : "#";
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <p>{footerCopy.blurb}</p>
    <a href={backHref}>{footerCopy.backToTop}</a>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding: 1.5rem 0 2.5rem;
  }

  .site-footer__inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .site-footer a {
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (max-width: 720px) {
    .site-footer__inner {
      flex-direction: column;
    }
  }
</style>
