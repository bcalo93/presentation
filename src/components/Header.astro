---
import ColorMode from "@/assets/svgs/color-mode.svg";
import { getHomePath, getSwitcherPath } from "@/i18n/config";
import type { CollectionEntry } from "astro:content";
import type { Locale } from "@/i18n/config";

interface Props {
  locale: Locale;
  page: "home" | "project";
  slug?: string;
  homeEntry: CollectionEntry<"home">;
}

const { locale, page, slug, homeEntry } = Astro.props;
const homeHref = getHomePath(locale);
const navItems = homeEntry.data.nav.items.map((item) => ({
  ...item,
  href: page === "home" ? `#${item.id}` : `${homeHref}#${item.id}`,
}));
const switchTo = locale === "en" ? "es" : "en";
const languageHref = getSwitcherPath(switchTo, page, slug);
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-header__brand" href={page === "home" ? "#home" : homeHref}
      >Brahian Calo</a
    >
    <nav class="site-header__nav" aria-label={homeEntry.data.nav.ariaLabel}>
      <ul class="site-header__nav-list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="site-header__controls">
      <a
        class="language-switcher"
        href={languageHref}
        aria-label={homeEntry.data.nav.languageSwitcherLabel}
      >
        {homeEntry.data.nav.languageLabels[switchTo]}
      </a>
      <button
        class="theme-toggle"
        type="button"
        aria-label={homeEntry.data.nav.themeToggleLabel}
        title={homeEntry.data.nav.themeToggleLabel}
        aria-pressed="false"
        data-theme-toggle
      >
        <span class="theme-toggle__icon" aria-hidden="true">
          <ColorMode />
        </span>
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (() => {
    const storageKey = "theme";
    const button = document.querySelector("[data-theme-toggle]");
    if (!button) return;

    const meta = document.getElementById("theme-color");

    const applyTheme = (theme) => {
      document.documentElement.dataset.theme = theme;
      localStorage.setItem(storageKey, theme);
      if (meta) {
        meta.setAttribute("content", theme === "dark" ? "#0E1419" : "#F4F1EA");
      }
      button.setAttribute("aria-pressed", String(theme === "dark"));
    };

    button.setAttribute(
      "aria-pressed",
      String(document.documentElement.dataset.theme === "dark"),
    );

    button.addEventListener("click", () => {
      const currentTheme =
        document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      const nextTheme = currentTheme === "dark" ? "light" : "dark";
      applyTheme(nextTheme);
    });
  })();
</script>

<style lang="scss">
  @use "../assets/styles/index" as *;

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: space(sm) 0;
    background: color-mix(in srgb, var(--color-canvas) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid
      color-mix(in srgb, var(--color-border) 80%, transparent);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto auto;
    grid-template-areas: "brand nav controls";
    align-items: center;
    gap: space(md);
  }

  .site-header__brand {
    grid-area: brand;
    font-weight: 700;
    white-space: nowrap;
  }

  .site-header__nav {
    grid-area: nav;
  }

  .site-header__nav-list {
    display: flex;
    align-items: center;
    gap: space(md);
  }

  .site-header__nav-list a {
    color: color(text-muted);
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .site-header__controls {
    grid-area: controls;
    display: flex;
    align-items: center;
    gap: space(xs);
  }

  .language-switcher {
    color: color(text-muted);
    font-size: 0.95rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: radius(sm);
    background: transparent;
    color: color(text-muted);
    font: inherit;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .theme-toggle:hover {
    color: color(accent);
  }

  .theme-toggle__icon {
    display: inline-flex;
    line-height: 1;
  }

  .theme-toggle__icon :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
  }

  .site-header__nav-list a:hover,
  .site-header__brand:hover,
  .language-switcher:hover {
    color: color(accent);
  }

  @include respond-below(sm) {
    .site-header__inner {
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "brand controls"
        "nav nav";
      gap: space(sm) space(md);
    }

    .site-header__nav {
      width: 100%;
      overflow-x: auto;
      scrollbar-width: thin;
      padding-bottom: space(2xs);
      -webkit-overflow-scrolling: touch;
    }
  }
</style>
