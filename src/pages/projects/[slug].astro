---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import ProjectCaseStudy from "@/components/ProjectCaseStudy.astro";
import { getHomeEntry, getLocalizedProjectByPath } from "@/utils/content";
import { getProjectPath } from "@/i18n/config";

export async function getStaticPaths() {
  const projects = await getCollection(
    "projects",
    ({ data }) => data.locale === "en",
  );

  return projects.map((project) => ({
    params: { slug: project.data.path },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const locale = "en";
const { project } = Astro.props;
const homeEntry = await getHomeEntry(locale);
const localizedSpanishProject = await getLocalizedProjectByPath(
  "es",
  project.data.path,
);
const title = `${project.data.title} | ${homeEntry.data.projectPage.eyebrow} | Brahian Calo`;
const description = project.data.summary;
---

<Layout
  title={title}
  description={description}
  locale={locale}
  canonicalPath={getProjectPath(locale, project.data.path)}
  alternatePaths={{
    en: getProjectPath("en", project.data.path),
    es: localizedSpanishProject
      ? getProjectPath("es", localizedSpanishProject.data.path)
      : "/es",
  }}
  page="project"
  slug={project.data.path}
  homeEntry={homeEntry}
>
  <ProjectCaseStudy
    homeEntry={homeEntry}
    project={project}
    backHref="/#projects"
  />
</Layout>
